# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (create a free cluster at https://cloud.mongodb.com)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/ai_ecommerce?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# OpenAI (used for generating vector embeddings for semantic/AI search)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Name of the Atlas Vector Search index (created via scripts/createVectorIndex.js or Atlas UI)
VECTOR_INDEX_NAME=product_vector_index
